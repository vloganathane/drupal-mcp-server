# Drupal MCP Server Configuration
# Copy to .env and fill in your values

# === Drupal Connection ===
DRUPAL_BASE_URL=https://your-drupal-site.com
DRUPAL_AUTH_TYPE=token
DRUPAL_AUTH_TOKEN=your-api-token-here

# For basic auth:
# DRUPAL_AUTH_TYPE=basic
# DRUPAL_USERNAME=admin
# DRUPAL_PASSWORD=your-password

# For OAuth2:
# DRUPAL_AUTH_TYPE=oauth2
# DRUPAL_OAUTH_CLIENT_ID=your-client-id
# DRUPAL_OAUTH_CLIENT_SECRET=your-client-secret
# DRUPAL_OAUTH_TOKEN_URL=https://your-site.com/oauth/token

# === AI Provider (choose one) ===
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# AI_PROVIDER=google
# GOOGLE_API_KEY=...

# === Drush Configuration ===
DRUSH_PATH=/usr/local/bin/drush
DRUSH_ROOT=/var/www/html

# === DDEV Configuration ===
DDEV_PROJECT_PATH=/path/to/your/drupal-project
